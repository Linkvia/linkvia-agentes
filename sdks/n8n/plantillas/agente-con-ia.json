    {
      "parameters": {
        "jsCode": "// La charla como la pide Claude: los últimos mensajes, alternando usuario y agente.\n// Cambiá SISTEMA por lo que tiene que saber tu agente (horarios, precios, cómo contestar).\nconst SISTEMA = 'Sos el asistente de un negocio. Contestá corto, en castellano rioplatense y con amabilidad. Si no sabés algo, decilo y ofrecé pasar con una persona.';\nconst historial = $json.messages ?? [];\nconst mensajes = [];\nfor (const m of historial) {\n  if (m.deleted || m.from === 'system') continue;\n  const role = m.from === 'user' ? 'user' : 'assistant';\n  const last = mensajes[mensajes.length - 1];\n  if (last && last.role === role) last.content += '\\n' + m.text;\n  else mensajes.push({ role, content: m.text });\n}\nwhile (mensajes.length && mensajes[0].role !== 'user') mensajes.shift();\n// Claude contesta al último mensaje del usuario: lo que el agente ya dijo después, se saca.\nwhile (mensajes.length && mensajes[mensajes.length - 1].role !== 'user') mensajes.pop();\nif (!mensajes.length) mensajes.push({ role: 'user', content: $('Linkvia Trigger').item.json.message.text });\nreturn [{ json: { model: 'claude-haiku-5-5', max_tokens: 800, system: SISTEMA, messages: mensajes } }];"
      },
      "name": "Armar la charla",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "id": "7a1c2a4e-1f0b-4c55-9f3a-0b6a1c0e1a04"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 60000
        }
      },
      "name": "Preguntarle a Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
